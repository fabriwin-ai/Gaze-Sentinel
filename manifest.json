{
  "manifest_version": 3,
  "name": "Kro-NOS Omega Neural Browser",
  "short_name": "Omega Browser",
  "version": "1.1.0",
  "description": "Gaze-driven Chromium control with an experimental Omega-SNNF field and Kro-NOS admission panel.",
  "author": "fabriwin-ai",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Gaze Sentinel",
    "default_icon": "icons/icon-128.png"
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["omega-core.js", "omega-overlay.js", "content-script.js"],
    "css": ["omega.css"],
    "run_at": "document_idle"
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self'; object-src 'self';"
  }
}